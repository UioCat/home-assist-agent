{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "message",
    "tool_plan"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "indirect_iot",
        "other"
      ]
    },
    "message": {
      "type": "string"
    },
    "tool_plan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_name",
            "arguments_json"
          ],
          "properties": {
            "tool_name": {
              "type": "string"
            },
            "arguments_json": {
              "type": "string",
              "description": "JSON object encoded as a string; must match the selected tool input_schema"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
