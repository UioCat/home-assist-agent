HOST=127.0.0.1
PORT=8080

HA_BASE_URL=http://homeassistant.local:8123
HA_MCP_URL=http://homeassistant.local:8123/api/mcp
HA_TOKEN=
HA_CATALOG_TIMEOUT_SECONDS=10
HA_MCP_TIMEOUT_SECONDS=20

HOME_ID=local-home
PERSON_ID=local-user
TARGET_RESOLUTION_ENABLED=true
TARGET_RESOLUTION_CONFIDENCE=0.80
TARGET_CANDIDATE_LIMIT=20
TERM_PROVISIONAL_SECONDS=600

CODEX_BINARY=codex
CORS_ORIGINS=["http://127.0.0.1:8090"]
AUDIT_DB_PATH=data/audit.db
EVENT_DB_PATH=data/events.db
TERM_DB_PATH=data/terms.db
CONVERSATION_DB_PATH=data/conversations.db
